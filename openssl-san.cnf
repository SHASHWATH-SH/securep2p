[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
req_extensions     = req_ext
distinguished_name = dn

[ dn ]
C = IN
ST = Karnataka
L = Bangalore
O = SecureP2P
OU = Dev
CN = 172.17.1.95

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
IP.1 = 172.17.1.95
DNS.1 = localhost
